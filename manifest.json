{
  "manifest_version": 3,
  "name": "seek2csv",
  "version": "0.2.0",
  "description": "Export data from the current page to a CSV file.",
  "action": {
    "default_title": "Export applied jobs to CSV"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting"]
}
